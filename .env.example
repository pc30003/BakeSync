# ─── App Mode ────────────────────────────────────────────────────────────────
# "demo"       → competition demo, one-click login, no password checks, demo banner
# "production" → real bakeries, bcrypt passwords, sign-up flow, billing
NEXT_PUBLIC_APP_MODE="demo"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/bakesync"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth (optional — leave blank to disable Google login) ──────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI / Agent ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# Model to use — gpt-4o recommended, gpt-4o-mini for cost savings
OPENAI_MODEL="gpt-4o"

# ─── Cron / Background Tasks ──────────────────────────────────────────────────
# Secret shared between Vercel Cron and the /api/agent/* routes.
# Generate: openssl rand -hex 32
CRON_SECRET="change-me-to-a-random-hex-string"

# ─── Push Notifications (VAPID) ───────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@bakesync.app"

# ─── Email (Resend — for invites, password resets) ────────────────────────────
# Sign up at https://resend.com — free tier is generous
RESEND_API_KEY=""
EMAIL_FROM="BakeSync <noreply@bakesync.app>"

# ─── Stripe (production billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs from your Stripe dashboard
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# ─── External Integrations (future) ──────────────────────────────────────────
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_STORE_DOMAIN=""

SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
